}

void BT_Send_Status(void)
{
    // dumps all sensor + system info as text, used by command 5
    UART_Send_String("\r\n=== STATUS REPORT ===\r\n");
    UART_Send_String("TIME  : ");
    UART_Send_Num(hour);   UART_Send_Char(':');
    UART_Send_Num(minute); UART_Send_Char(':');
    UART_Send_Num(sec);    UART_Send_String("\r\n");
    UART_Send_String("DATE  : ");
    UART_Send_Num(date);  UART_Send_Char('/');
    UART_Send_Num(month); UART_Send_Char('/');
    UART_Send_Num(year);  UART_Send_String("\r\n");
    UART_Send_String("TEMP  : ");
    if(tempRaw<LM35_MIN_RAW || tempRaw>LM35_MAX_RAW) UART_Send_String("N/A");  // sensor probably unplugged
    else{ UART_Send_Num(tempC); UART_Send_Char('C'); }
    UART_Send_String("\r\n");
    UART_Send_String("GAS   : ");
    UART_Send_Num(gasRaw);
    UART_Send_String(gasAlert ? " [ALERT]\r\n" : " [OK]\r\n");
    UART_Send_String("PIR   : ");
    UART_Send_String(motionDetected ? "DETECTED\r\n" : "CLEAR\r\n");
    UART_Send_String("LIGHT : ");
    UART_Send_String(darkDetected ? "DARK\r\n" : "BRIGHT\r\n");
    UART_Send_String("LED   : ");
    UART_Send_String(PORTBbits.RB1 ? "ON\r\n" : "OFF\r\n");
    UART_Send_String("DOOR  : ");
    UART_Send_String(doorOpen ? "OPEN\r\n" : "CLOSED\r\n");
    UART_Send_String("BUZZER: ");
    UART_Send_String(PORTBbits.RB0 ? "ON\r\n" : "OFF\r\n");
    UART_Send_String("ALARM : ");
    if(gasAlert && tempAlert)  UART_Send_String("GAS+TEMP\r\n");
    else if(gasAlert)          UART_Send_String("GAS\r\n");
    else if(tempAlert)         UART_Send_String("TEMP\r\n");
    else                       UART_Send_String("NONE\r\n");
    UART_Send_String("=====================\r\n");
}

void BT_Handle_Cmd(unsigned char cmd)
{
    // simple switch-like check, one char command from phone app
    if     (cmd=='1'){ PORTBbits.RB0=1; UART_Send_String("BUZZER: ON\r\n"); }
    else if(cmd=='2'){ PORTBbits.RB0=0; UART_Send_String("BUZZER: OFF\r\n"); }
    else if(cmd=='3'){ Door_Open(); }
    else if(cmd=='4'){ Door_Close(); }
    else if(cmd=='5'){ RTC_Read(); BT_Send_Status(); }
    else if(cmd=='6')
{
    // force LED on for 3 sec, useful if you want light without waiting on sensors
    ledBoost = 1;
    ledBoostTimer = 3000;   // 3 seconds
    Apply_LED();
    UART_Send_String("LED BOOST ON\r\n");
}
else if(cmd=='7')
{
    // cancel the boost, go back to auto LED control
    ledBoost = 0;
    ledBoostTimer = 0;
    Apply_LED();
    UART_Send_String("LED BOOST OFF\r\n");
}   
    else if(cmd=='0'){ BT_Send_Menu(); }
    else if(cmd=='\r' || cmd=='\n' || cmd==' '){ return; }  // ignore enter/space, dont spam unknown cmd msg
    else { UART_Send_String("? Unknown. Send 0 for menu\r\n"); }
    UART_Flush();
}

// ================= DELAY WITH BT POLLING =================
// FIX: Read_PIR() is now called every 1ms here, so PIR is always fresh
// during ALL screen delays ? not just Screen 1.
void delay_with_bt(unsigned int ms)
{
    // basically a replacement for __delay_ms() that doesnt block everything else
    // checks bluetooth, button, and PIR every single millisecond
    unsigned int i;
    unsigned char cmd;
    for(i=0; i<ms; i++){
        cmd = UART_Read_If_Available();
        if(cmd) BT_Handle_Cmd(cmd);
        Check_Button();
        Read_PIR();        // <-- FIX: PIR sampled every 1ms during all screens
        Apply_LED();
        __delay_ms(1);
    }
}

// ================= SERVO =================
void Servo_Init(void)
{
    // sets up CCP1 module for PWM on RC2, used to drive servo
    TRISCbits.TRISC2 = 0;
    PR2     = 155;     // sets PWM period (~20ms for servo, matches timer2 prescaler)
    T2CON   = 0x07;    // timer2 on, prescaler 16
    CCP1CON = 0x00;    // PWM off until we actually move servo
    PORTCbits.RC2 = 0;
}

void set_servo_us(unsigned int us)
{
    // converts microseconds pulse width into the duty cycle value CCP needs
    unsigned int duty;
    CCP1CON = 0x0C;   // PWM mode on
    duty = (unsigned int)((unsigned long)us * 5 / 64);
    if(duty > 255) duty = 255;  // clamp so it doesnt overflow the register
    CCPR1L = (unsigned char)duty;
}

void stop_servo(void)
{
    // turns off PWM so servo doesnt jitter/hum when not moving
    CCP1CON = 0x00;
    PORTCbits.RC2 = 0;
}

void move_smooth_us(unsigned int target_us)
{
    // moves servo gradually instead of snapping straight to target
    // this is gentler on the gears and looks way better
    unsigned char i;
    unsigned char cmd;

    while(current_servo_us != target_us)
    {
        if(current_servo_us < target_us){
            if((target_us - current_servo_us) < SERVO_STEP_US)
                current_servo_us = target_us;
            else
                current_servo_us += SERVO_STEP_US;
        } else {
            if((current_servo_us - target_us) < SERVO_STEP_US)
                current_servo_us = target_us;
            else
                current_servo_us -= SERVO_STEP_US;
        }

        set_servo_us(current_servo_us);

        // keep checking BT/PIR even while servo is mid-move so nothing freezes
        for(i=0; i<SERVO_STEP_DELAY_MS; i++)
        {
            cmd = UART_Read_If_Available();
            if(cmd=='1'){ PORTBbits.RB0=1; }
            else if(cmd=='2'){ PORTBbits.RB0=0; }
            else if(cmd=='5'){ RTC_Read(); BT_Send_Status(); }
            else if(cmd=='0'){ BT_Send_Menu(); }

            Read_PIR();    // <-- FIX: also poll PIR during servo movement
            Apply_LED();
            __delay_ms(1);
        }
    }

    __delay_ms(150);  // let servo settle before cutting power
    stop_servo();
}

void Door_Open(void)
{
    move_smooth_us(SERVO_OPEN_US);
    doorOpen = 1;
    UART_Send_String("DOOR: OPENED\r\n");
}

void Door_Close(void)
{
    move_smooth_us(SERVO_CLOSE_US);
    doorOpen = 0;
    UART_Send_String("DOOR: CLOSED\r\n");
}

// ================= BUTTON =================
void Check_Button(void)
{
    // basic debounce: check twice with a small delay between, then wait for release
    if(BUTTON == 0){
        __delay_ms(30);
        if(BUTTON == 0){
            while(BUTTON == 0);   // wait here until button is let go
            __delay_ms(50);
            if(doorOpen == 0) Door_Open();
            else              Door_Close();
        }
    }
}

void __interrupt() ISR(void)
{
    // fires whenever a byte comes in over UART, grab it and set the flag
    // keeping this short on purpose, actual command handling happens in main loop
    if(PIR1bits.RCIF)   // UART receive interrupt
    {
        received_cmd = RCREG;
        newCmd = 1;
    }
}

