// ================= LCD =================
void pulse_EN(void) { E=1; __delay_ms(2); E=0; __delay_ms(2); }  // toggle enable pin so LCD reads the data

void send_nibble(unsigned char n)
{
    // send 4 bits at a time (4-bit mode)
    D4=(n>>0)&1; D5=(n>>1)&1; D6=(n>>2)&1; D7=(n>>3)&1;
    pulse_EN();
}

void lcd_cmd(unsigned char cmd)
{
    // RS=0 means this is a command, not data. send high nibble then low nibble
    RS=0; send_nibble(cmd>>4); send_nibble(cmd&0x0F); __delay_ms(5);
}

void lcd_data(unsigned char dat)
{
    // RS=1 means this is actual character data to display
    RS=1; send_nibble(dat>>4); send_nibble(dat&0x0F); __delay_ms(2);
}

void lcd_init(void)
{
    // standard 4-bit LCD init sequence from datasheet
    TRISD=0x00; PORTD=0x00; __delay_ms(100); RS=0;
    send_nibble(0x03); __delay_ms(5);
    send_nibble(0x03); __delay_ms(5);
    send_nibble(0x03); __delay_ms(5);
    send_nibble(0x02);  // switch to 4-bit mode
    lcd_cmd(0x28); lcd_cmd(0x0C); lcd_cmd(0x06); lcd_cmd(0x01); __delay_ms(5);
}

void lcd_set_cursor(unsigned char row, unsigned char col)
{
    // row 1 or row 2, col starts at 1
    if(row==1) lcd_cmd(0x80+col-1);
    else       lcd_cmd(0xC0+col-1);
}

void lcd_print(const char *s)         { while(*s){ lcd_data(*s); s++; } }  // print whole string
void lcd_print_digit(unsigned char v) { lcd_data((v/10)+'0'); lcd_data((v%10)+'0'); }  // always 2 digits, for time/date

void lcd_print_uint(unsigned int val)
{
    // converts number to string and prints it (no built in itoa so doing manually)
    char buf[6]; unsigned char i=0;
    if(val==0){ lcd_data('0'); return; }
    while(val>0&&i<5){ buf[i++]=(val%10)+'0'; val/=10; }
    while(i>0) lcd_data(buf[--i]);  // print in reverse order since we built it backwards
}

// ================= SOFTWARE I2C =================
// bit-banged i2c since not using hardware MSSP module here
#define SCL_LOW()     do{ TRISCbits.TRISC3=0; PORTCbits.RC3=0; }while(0)
#define SCL_RELEASE() do{ TRISCbits.TRISC3=1; }while(0)
#define SDA_LOW()     do{ TRISCbits.TRISC4=0; PORTCbits.RC4=0; }while(0)
#define SDA_RELEASE() do{ TRISCbits.TRISC4=1; }while(0)
#define SDA_READ()    PORTCbits.RC4

void I2C_Delay(void) { __delay_us(10); }
void I2C_Init(void)  { SDA_RELEASE(); SCL_RELEASE(); __delay_ms(10); }

void I2C_Start(void)
{
    // start condition: SDA goes low while SCL is high
    SDA_RELEASE(); SCL_RELEASE(); I2C_Delay();
    SDA_LOW(); I2C_Delay(); SCL_LOW(); I2C_Delay();
}

void I2C_Stop(void)
{
    // stop condition: SDA goes high while SCL is high
    SDA_LOW(); I2C_Delay(); SCL_RELEASE(); I2C_Delay(); SDA_RELEASE(); I2C_Delay();
}

void I2C_Repeated_Start(void)
{
    SDA_RELEASE(); I2C_Delay(); SCL_RELEASE(); I2C_Delay();
    SDA_LOW(); I2C_Delay(); SCL_LOW(); I2C_Delay();
}

unsigned char I2C_Write_Byte(unsigned char data)
{
    // shifts out 8 bits MSB first, then checks for ack from slave
    unsigned char i, ack;
    for(i=0;i<8;i++){
        if(data&0x80) SDA_RELEASE(); else SDA_LOW();
        I2C_Delay(); SCL_RELEASE(); I2C_Delay(); SCL_LOW(); I2C_Delay();
        data<<=1;
    }
    SDA_RELEASE(); I2C_Delay(); SCL_RELEASE(); I2C_Delay();
    ack=SDA_READ(); SCL_LOW(); I2C_Delay();
    return ack;
}

unsigned char I2C_Read_Byte(unsigned char sendAck)
{
    // reads 8 bits in, then sends ack/nack depending on if more bytes needed
    unsigned char i, data=0;
    SDA_RELEASE();
    for(i=0;i<8;i++){
        data<<=1; SCL_RELEASE(); I2C_Delay();
        if(SDA_READ()) data|=1;
        SCL_LOW(); I2C_Delay();
    }
    if(sendAck) SDA_LOW(); else SDA_RELEASE();
    I2C_Delay(); SCL_RELEASE(); I2C_Delay(); SCL_LOW(); I2C_Delay();
    SDA_RELEASE();
    return data;
}

// ================= BCD =================
// RTC stores time in BCD format not normal binary, so need to convert
unsigned char Dec_To_BCD(unsigned char d){ return ((d/10)<<4)|(d%10); }
unsigned char BCD_To_Dec(unsigned char b){ return ((b>>4)*10)+(b&0x0F); }

// ================= RTC =================
void RTC_Set(unsigned char hh, unsigned char mm, unsigned char ss,
             unsigned char dd, unsigned char mo, unsigned char yy)
{
    // writes time to DS1307 registers starting at address 0x00
    I2C_Start();
    I2C_Write_Byte(RTC_ADDR<<1); I2C_Write_Byte(0x00);
    I2C_Write_Byte(Dec_To_BCD(ss)&0x7F);  // bit7=0 to make sure clock is running
    I2C_Write_Byte(Dec_To_BCD(mm));
    I2C_Write_Byte(Dec_To_BCD(hh)&0x3F);  // bit6=0 for 24hr mode
    I2C_Write_Byte(0x01);   // day of week, not really using this
    I2C_Write_Byte(Dec_To_BCD(dd));
    I2C_Write_Byte(Dec_To_BCD(mo));
    I2C_Write_Byte(Dec_To_BCD(yy));
    I2C_Stop(); __delay_ms(50);
}

void RTC_Read(void)
{
    // point to register 0, then read 7 bytes back (sec,min,hour,dow,date,month,year)
    I2C_Start();
    I2C_Write_Byte(RTC_ADDR<<1); I2C_Write_Byte(0x00);
    I2C_Repeated_Start();
    I2C_Write_Byte((RTC_ADDR<<1)|1);
    sec    = BCD_To_Dec(I2C_Read_Byte(1)&0x7F);
    minute = BCD_To_Dec(I2C_Read_Byte(1));
    hour   = BCD_To_Dec(I2C_Read_Byte(1)&0x3F);
    I2C_Read_Byte(1);   // skip day of week byte, dont need it
    date   = BCD_To_Dec(I2C_Read_Byte(1));
    month  = BCD_To_Dec(I2C_Read_Byte(1));
    year   = BCD_To_Dec(I2C_Read_Byte(0));  // last byte, send NACK (0) to end read
    I2C_Stop();
}

// ================= ADC =================
void ADC_Init(void)
{
    // STEP 1: Reset all ports to digital (makes RE0 work as digital PIR input)
    ADCON1 = 0x07;
    TRISEbits.TRISE0 = 1;   // RE0 = PIR input (digital)
    __delay_ms(10);

    // STEP 2: Re-enable only AN0, AN1, AN2 as analog for sensors
    ADCON1 = 0x82;           // right-justified, AN0/AN1/AN2 analog, RE0 stays digital
    ADCON0 = 0x81;           // ADC ON, channel 0
    TRISA  = 0xFF;           // All PORTA as input
    TRISBbits.TRISB0 = 0;   // RB0 = buzzer output
    TRISBbits.TRISB1 = 0;   // RB1 = LED output
    TRISBbits.TRISB2 = 0;   // RB2 = spare
    PORTB  = 0x00;
}

unsigned int ADC_Read(unsigned char channel)
{
    // select channel, wait a bit for it to settle, start conversion, wait till done
    ADCON0 &= 0b11000101;
    ADCON0 |= (channel<<3);
    __delay_ms(5);
    GO_nDONE=1; while(GO_nDONE);  // wait for conversion to finish
    return ((unsigned int)(ADRESH<<8)+ADRESL);  // combine high+low byte into 10-bit result
}

// ================= UART =================
void UART_Init(void)
{
    TRISCbits.TRISC6 = 0;  // TX pin = output
    TRISCbits.TRISC7 = 1;  // RX pin = input
    SPBRG  = 129;           // baud rate setting for 9600 @ 20MHz
    TXSTA  = 0x24;          // TX enabled, high speed baud
    RCSTA  = 0x90;          // serial port enabled, continuous receive
    SPBRG  = 129;


    PIE1bits.RCIE = 1;     // enable RX interrupt so we catch BT commands instantly
    INTCONbits.PEIE = 1;   // enable peripheral interrupts
    INTCONbits.GIE  = 1;   // enable global interrupts
    
    __delay_ms(100);
}

void UART_Send_Char(unsigned char c)
{
    while(!TXSTAbits.TRMT);  // wait till transmit buffer is empty
    TXREG = c;
}

void UART_Send_String(const char *s) { while(*s){ UART_Send_Char(*s); s++; } }

void UART_Send_Num(unsigned int val)
{
    // same trick as lcd_print_uint, build digits backwards then print in order
    char buf[6]; unsigned char i=0;
    if(val==0){ UART_Send_Char('0'); return; }
    while(val>0&&i<5){ buf[i++]=(val%10)+'0'; val/=10; }
    while(i>0) UART_Send_Char(buf[--i]);
}

unsigned char UART_Read_If_Available(void)
{
    // check for overrun error first or UART can lock up
    if(RCSTAbits.OERR){
        RCSTAbits.CREN = 0;
        RCSTAbits.CREN = 1;
        return 0;
    }
    if(PIR1bits.RCIF) return RCREG;  // got a byte, return it
    return 0;  // nothing waiting
}

void UART_Flush(void)
{
    // clears out any leftover bytes so old commands dont get reprocessed
    unsigned char dummy;
    while(!TXSTAbits.TRMT);
    __delay_ms(5);
    while(PIR1bits.RCIF){ dummy=RCREG; (void)dummy; }
}

// ================= APPLY LED STATE =================
void Apply_LED(void)
{
    // LED turns on automatically if its dark or motion detected
    unsigned char sensorLED = (motionDetected || darkDetected);

    // unless boost mode is active, then force it on regardless
    if(ledBoost && ledBoostTimer > 0)
        PORTBbits.RB1 = 1;
    else
        PORTBbits.RB1 = sensorLED;
}

void LED_Service(void)
{
    // counts down the boost timer, turns boost off when it hits 0
    if(ledBoostTimer > 0)
        ledBoostTimer--;
    else
        ledBoost = 0;

    Apply_LED();
}

// ================= READ PIR =================
// FIX 1: Requires PIR_CONFIRM_COUNT consecutive HIGH reads before triggering.
// FIX 2: Holds motionDetected ON for PIR_HOLD_LOOPS cycles after last HIGH,
//         so brief LOW glitches between PIR pulses do NOT clear the detection.
void Read_PIR(void)
{
    if(PORTEbits.RE0 == 1)
    {
        // PIR is HIGH, count it up (debounce so random noise doesnt trigger it)
        if(pirConfirm < PIR_CONFIRM_COUNT)
            pirConfirm++;

        if(pirConfirm >= PIR_CONFIRM_COUNT)
        {
            motionDetected = 1;
            pirHoldTimer   = PIR_HOLD_LOOPS;   // reset hold timer every time we see HIGH
        }
    }
    else
    {
        // PIR went LOW, reset the confirm counter right away
        pirConfirm = 0;

        // but dont clear motion yet, count down the hold first
        // this stops the display from flickering between pulses
        if(pirHoldTimer > 0)
            pirHoldTimer--;
        else
            motionDetected = 0;
    }
}

