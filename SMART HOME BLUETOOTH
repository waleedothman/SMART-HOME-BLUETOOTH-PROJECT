        // convert raw ADC value to actual celsius (LM35 = 10mV per degree)
        if(tempRaw>=LM35_MIN_RAW && tempRaw<=LM35_MAX_RAW)
            tempC=(unsigned int)(((unsigned long)tempRaw*500UL)/1023UL);
        else
            tempC=0;   // out of range = treat as invalid reading

        gasRaw = ADC_Read(1);
        ldrRaw = ADC_Read(2);

        // ===== READ PIR =====
        // Called here AND inside delay_with_bt() and move_smooth_us()
        // so it is always up to date regardless of which screen is active.
        Read_PIR();

        darkDetected = (ldrRaw > LDR_THRESHOLD);

        // ===== UPDATE LED =====
        Apply_LED();

        // ===== ALERTS =====
        gasAlert  = (gasRaw > GAS_THRESHOLD);
        tempAlert = (tempC  > TEMP_THRESHOLD_C);

        // ===== BUZZER =====
        // start the alarm once, then let it beep for a fixed number of cycles
        if((gasAlert||tempAlert) && !alarmLatched){
            alarmLatched=1; buzzCounter=BUZZ_CYCLES; PORTBbits.RB0=1;
            UART_Send_String("!! ALARM TRIGGERED\r\n");
        }
        if(alarmLatched && buzzCounter>0){
            buzzCounter--;
            if(buzzCounter==0) PORTBbits.RB0=0;
        }
        // reset alarm once the danger is gone and buzzer cycle finished
        if(!gasAlert && !tempAlert && buzzCounter==0){ alarmLatched=0; PORTBbits.RB0=0; }

        // ===== SCREEN 1: TIME =====
        // shows live clock, updates twice per loop (1 sec total) so it doesnt look frozen
        lcd_cmd(0x01);
        lcd_set_cursor(1,1); lcd_print("TIME: --:--:--");
        lcd_set_cursor(2,1); lcd_print("DATE: ");
        RTC_Read();
        lcd_print_digit(date);  lcd_data('/');
        lcd_print_digit(month); lcd_data('/');
        lcd_print_digit(year);
        {
            unsigned char i;
            for(i=0;i<2;i++){
                Check_Button();
                Read_PIR();
                Apply_LED();
                RTC_Read();
                lcd_set_cursor(1,7);
                lcd_print_digit(hour);   lcd_data(':');
                lcd_print_digit(minute); lcd_data(':');
                lcd_print_digit(sec);
                delay_with_bt(500);
            }
        }

        // ===== SCREEN 2: TEMP / GAS =====
        lcd_cmd(0x01);
        lcd_set_cursor(1,1); lcd_print("TEMP: ");
        if(tempRaw<LM35_MIN_RAW || tempRaw>LM35_MAX_RAW) lcd_print("N/A   ");
        else{ lcd_print_uint(tempC); lcd_data('C'); lcd_print("   "); }
        lcd_set_cursor(2,1); lcd_print("GAS:");
        lcd_print_uint(gasRaw); lcd_print(" ");
        if(gasAlert) lcd_print("ALT");
        else         lcd_print("OK ");
        delay_with_bt(1000);

        // ===== SCREEN 3: PIR / LDR =====
        lcd_cmd(0x01);
        lcd_set_cursor(1,1); lcd_print("MOTION: ");
        if(motionDetected) lcd_print("DETECT");
        else               lcd_print("NONE  ");
        lcd_set_cursor(2,1); lcd_print("LIGHT: ");
        if(darkDetected)   lcd_print("DARK  ");
        else               lcd_print("BRIGHT");
        delay_with_bt(1000);

        // ===== SCREEN 4: ALARM / DOOR =====
        lcd_cmd(0x01);
        lcd_set_cursor(1,1); lcd_print("ALARM: ");
        if(gasAlert && tempAlert) lcd_print("BOTH  ");
        else if(gasAlert)         lcd_print("GAS   ");
        else if(tempAlert)        lcd_print("TEMP  ");
        else                      lcd_print("OFF   ");
        lcd_set_cursor(2,1); lcd_print("DOOR: ");
        if(doorOpen) lcd_print("OPEN  ");
        else         lcd_print("CLOSED");
        delay_with_bt(1000);

        // ===== SCREEN 5: SUMMARY =====
        lcd_cmd(0x01);
        lcd_set_cursor(1,1); lcd_print("SYS: ");
        if(gasAlert || tempAlert) lcd_print("ALERT");
        else                      lcd_print("OK   ");
        lcd_set_cursor(2,1); lcd_print("LED: ");
        if(PORTBbits.RB1) lcd_print("ON ");
        else              lcd_print("OFF");
        delay_with_bt(1000);
        // loop goes back to top and repeats forever, cycling through all 5 screens
    }
}
